# RevoltOS Git Ignore Rules
build/
*.iso
*.iso.sha256
*.qcow2
*.log
.build/
distro/live-build/.build/
distro/live-build/chroot/
distro/live-build/binary/
distro/live-build/cache/
distro/live-build/local/
distro/live-build/*.iso
distro/live-build/*.log

# Python cache
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# C++ / CMake build outputs
CMakeFiles/
CMakeCache.txt
*.o
*.a
*.so

# Editor / OS files
.DS_Store
Thumbs.db
*.swp
*~
