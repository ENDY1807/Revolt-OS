#!/bin/sh
set -e

# RevoltOS live-build auto-config
lb config noauto \
    --mode debian \
    --system live \
    --distribution bookworm \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "http://deb.debian.org/debian" \
    --mirror-binary "http://deb.debian.org/debian" \
    --security true \
    --updates true \
    --backports true \
    --apt-indices true \
    --apt-recommends true \
    --bootloader "grub-efi" \
    --iso-application "RevoltOS Desktop" \
    --iso-preparer "RevoltOS Engineering Team" \
    --iso-publisher "RevoltOS <https://revoltos.org>" \
    --iso-volume "REVOLTOS_AMD64" \
    --image-name "revoltos-amd64" \
    --memtest none \
    "${@}"
