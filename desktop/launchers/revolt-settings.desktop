[Desktop Entry]
Version=1.0
Type=Application
Name=Revolt Settings
Comment=System & Desktop Configuration Center
Exec=python3 -c "import sys, os; from PyQt6.QtCore import QUrl; from PyQt6.QtGui import QGuiApplication; from PyQt6.QtQml import QQmlApplicationEngine; app = QGuiApplication(sys.argv); engine = QQmlApplicationEngine(); engine.load(QUrl.fromLocalFile('/usr/share/revoltos/applications/settings/Settings.qml')); sys.exit(app.exec())"
Icon=preferences-system
Terminal=false
Categories=Settings;
StartupNotify=true
